{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "error",
    "consistent-type-imports": "error"
  },
  "overrides": [
    {
      "files": ["src/main.ts", "src/tools/*.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/", "deploy/"]
}
